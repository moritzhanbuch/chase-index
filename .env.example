# Copy to .env and fill in what you have. Everything optional except the contact email.

# Used in the User-Agent for polite scraping (required by SEC EDGAR policy)
CONTACT_EMAIL=your-email@example.com

# Optional: UK Companies House API (free key: https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=

# Optional: ONLY if you want project scripts to call model APIs directly (billed per token).
# Leave empty to keep everything on your Claude subscription. Claude Code does not need these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Hard cap for any paid API spend during the run
MAX_API_SPEND_USD=15
